# Local development database. This path is intentionally separate from RAS.
TURSO_DATABASE_URL=file:./.local/reservations.db
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=http://127.0.0.1:5173
# Generate a separate random secret for the scheduled return reminder endpoint.
# CRON_SECRET=

# Remote Turso only. Do not commit secrets.
# TURSO_AUTH_TOKEN=

# Brevo reminder emails and optional magic links. Password sign-in works without it.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=IEEE INSAT Student Branch

# Set for the initial administrator, then run bootstrap:superadmin.
# SUPERADMIN_EMAIL=
# SUPERADMIN_NAME=
