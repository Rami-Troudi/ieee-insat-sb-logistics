    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.1",
    "vercel": "^60.0.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.6"
